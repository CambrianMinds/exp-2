{
  "manifest_version": 3,
  "name": "Indiana Expungement Assistant",
  "version": "1.2.0",
  "description": "Scrapes Indiana MyCase court records and generates 10 official court-ready expungement pleadings under IC § 35-38-9 with zero telemetry.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://public.courts.in.gov/*",
    "https://mycase.in.gov/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://public.courts.in.gov/mycase/*",
        "https://mycase.in.gov/*"
      ],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://public.courts.in.gov/mycase/*",
        "https://mycase.in.gov/*"
      ],
      "js": ["eligibility.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Indiana Expungement Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
